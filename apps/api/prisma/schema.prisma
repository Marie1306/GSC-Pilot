// Roulements / livraisons
// ---------------------------------------------------------------------------

model Rolling {
  id                          String         @id @default(uuid())
  // Numéro d'affichage RL-AAAA-NNNN (28 août 2026, confirmé) — même patron
  // que BG-AAAA-NNNN/CS-AAAA-NNNN : jamais de remise à zéro annuelle,
  // l'année est seulement affichée. Utilisé par le Code QR du menu Options
  // (voir RollingQrCode.tsx) et par Scan QR (QrScanPage.tsx).
  rollingNumber               String         @unique
  contactId                   String
  contact                     Contact        @relation(fields: [contactId], references: [id])
  clientRequestId             String?        @unique
  clientRequest               ClientRequest? @relation(fields: [clientRequestId], references: [id])
  budgetId                    String?        @unique // nullable — création directe possible, avec ou sans budgétaire (confirmé)
  budget                      Budget?        @relation(fields: [budgetId], references: [id])
  status                      String         @default("active")
  sold                        Decimal        @default(0) @db.Decimal(12, 2)
  // Heures/achats planifiés — nuls tant qu'aucun budgétaire n'est attaché
  // (création directe sans budgétaire, comme Project). Alimentent la
  // Progression/le Comparatif/les tuiles financières au même titre que pour
  // un projet (28 août 2026, demande de l'utilisatrice) — jamais des
  // colonnes "actualHours"/"actualPurchases" séparées : toujours calculées
  // à la lecture depuis TimeEntry.rollingId/ProjectPurchaseEntry.rollingId,
  // même esprit que Project.
  plannedHours                Decimal        @default(0) @db.Decimal(10, 2)
  plannedPurchases            Decimal        @default(0) @db.Decimal(12, 2)
  // Marge visée — gelée à la conversion du budgétaire (même formule que
  // Project.targetMarginPct), nulle si le roulement n'a pas de budgétaire
  // d'origine.
  targetMarginPct             Decimal?       @db.Decimal(5, 2)
  // Back-up d'heures — champs gardés pour miroir structurel avec Project
  // mais VOLONTAIREMENT jamais alimentés ni lus : confirmé par l'utilisatrice
  // le 28 août 2026, « il n'y a pas de taux back-up sur un roulement ».
  // convertBudgetToRolling ne les fige jamais (contrairement à
  // transferBackupToProject) et computeRollingFinancials ne les référence
  // jamais — restent à 0/nul pour toujours. Ne pas les brancher un jour sans
  // reconfirmer, ce n'est pas un oubli.
  backupHours                 Decimal        @default(0) @db.Decimal(10, 2)
  backupHoursCost             Decimal        @default(0) @db.Decimal(12, 2)
  backupHourlyRate            Decimal?       @db.Decimal(10, 2)
  productionCompleted         Boolean        @default(false)
  fulfillmentMode             String?
  fulfillmentStatus           String?
  fulfillmentDriverId         String?
  fulfillmentAddress          String?
  fulfillmentScheduled        DateTime?
  // Miroir exact de Project.billingReady/fulfillmentConfirmationNote — requis
  // pour réutiliser confirmFulfillment/confirmWarehouseDelivery (fulfillment.ts)
  // tels quels (FulfillmentEntity générique), jamais une variante spéciale
  // pour Rolling.
  billingReady                Boolean        @default(false)
  fulfillmentConfirmationNote String?
  createdDirectly             Boolean        @default(false)
  closedAt                    DateTime?
  // Menu Options du roulement (28 août 2026) — même mécanisme exact que
  // Project.archivedAt/deletedAt (voir ce commentaire) : archivedAt reste
  // pleinement accessible, seulement sorti des listes actives; deletedAt est
  // la corbeille (masqué des listes, restauration 90 jours hors de cette
  // phase).
  archivedAt                  DateTime?
  deletedAt                   DateTime?
  createdById                 String
  createdAt                   DateTime       @default(now())
  // Post-mortem (20 août 2026, confirmé) : « la livraison termine le
  // roulement → statut "Terminé" → apparaît au Post-mortem. »
  postMortemDepassements      String?
  postMortemAmeliorations     String?
  postMortemRecommandation    String?

  invoiceEntries  InvoicePlanEntry[]
  deliveries      Delivery[]
  timeEntries     TimeEntry[]
  purchaseEntries ProjectPurchaseEntry[]
  serviceCalls    ServiceCall[]

  @@index([status])
}

model Delivery {
  id                String    @id @default(uuid())
  displayId         String    @unique // format BL-AAAA-NNNN
  type              String // project | rolling
  projectId         String?
  project           Project?  @relation(fields: [projectId], references: [id])
  rollingId         String?
  rolling           Rolling?  @relation(fields: [rollingId], references: [id])
  contactId         String
  contact           Contact   @relation(fields: [contactId], references: [id])
  address           String?
  scheduledAt       DateTime?
  items             String?
  driverEmployeeId  String? // seulement pour le mode "warehouse"
  status            String    @default("planned")
  signatureCaptured Boolean   @default(false)
  signatureImageUrl String?
  conditionNote     String?
  kmTraveled        Decimal?  @db.Decimal(10, 2)
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
}

