// GSC Pilot — schéma de base de données
//
// Dérivé entité par entité de docs/handoff/02-specification-metier/.
// Source de vérité pour les règles métier encodées ici : ce document, pas
// ce fichier — si un champ semble contredire la spécification, la
// spécification a raison (voir CLAUDE.md).
//
// ⚠️ persona reprend exactement les valeurs de packages/business-rules/src/roles.ts
// ("owner" = Direction, "boss" = Propriétaire) pour que les fonctions de ce
// module s'appliquent sans modification. Ne jamais assumer que owner = le
// propriétaire de l'entreprise.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 : les URL de connexion ne vivent plus ici, mais dans prisma.config.ts
// (CLI/migrations) et dans src/db.ts via un adaptateur (exécution de l'app).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identité
// ---------------------------------------------------------------------------

enum Persona {
  owner // Direction
  admin // Administration
  boss // Propriétaire
  member // Employé
  warehouse // Magasinier
}

model Employee {
  id                String      @id @default(uuid())
  authUserId        String?     @unique // lien vers auth.users de Supabase — nul tant que l'invitation n'est pas acceptée
  name              String
  initials          String
  email             String      @unique
  phone             String?
  persona           Persona
  jobTitle          String? // ex. "Fabrication", "Technicien" — distinct de persona (permission)
  skills            String[]    @default([])
  skillEfficiencies Json        @default("{}") // {[skill]: pct} — Gantt seulement, jamais le budgétaire/heures/post-mortem
  costRate          Decimal     @default(0) @db.Decimal(10, 2)
  // Classes facturables en service (plusieurs choix permis — confirmé par
  // l'utilisatrice le 18 août 2026) : un même employé peut avoir plusieurs
  // classes applicables (ex. programmeur ET technicien senior). La classe
  // réellement facturée se choisit AU PUNCH selon ce que la job demande,
  // jamais fixée une fois pour toutes ici — voir TimeEntry.techLevelId.
  // Remplace l'ancien lien 1:1 techLevelId, qui n'avait aucun consommateur
  // réel avant ce changement (vérifié avant de le retirer).
  techLevels        TechLevel[]
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  delegationsGranted    DelegationGrant[] @relation("DelegationGrantedBy")
  delegationsHeld       DelegationGrant[] @relation("DelegationDelegate")
  auditLogEntries       AuditLogEntry[]
  purchaseRequestsMade  PurchaseRequest[] @relation("PurchaseRequestRequester")
  timeEntries           TimeEntry[]
  assignedServiceCalls  ServiceCall[]
  assignedProjectTasks  ProjectTask[]
  errorReportsAsSubject ErrorReport[]     @relation("ErrorReportSubject")
  errorReportsCreated   ErrorReport[]     @relation("ErrorReportCreatedBy")
  teamNotesSent         TeamNote[]        @relation("TeamNoteSender")
  teamNotesReceived     TeamNote[]        @relation("TeamNoteRecipient")

  @@index([persona])
}

// Classes facturables en service (ex. Technicien, Technicien senior,
// Programmeur) — gérées par Direction en Paramètres, jamais codées en dur.
// Trois taux distincts par classe (régulier/temps supplémentaire/extra),
// choisis au punch selon le type de temps réel. Remplace l'ancien billRate
// unique (jamais utilisé par un vrai consommateur avant ce changement).
model TechLevel {
  id           String      @id @default(uuid())
  label        String // ex. "Technicien niveau 1/2/expert"
  regularRate  Decimal     @db.Decimal(10, 2)
  overtimeRate Decimal     @db.Decimal(10, 2)
  extraRate    Decimal     @db.Decimal(10, 2)
  active       Boolean     @default(true)
  sortOrder    Int         @default(0)
  employees    Employee[]
  timeEntries  TimeEntry[]
}

/// Délégation d'approbation — table réelle avec historique (amélioration sur le blob unique de la v19),
/// mappée vers la forme attendue par roles.ts (delegationActive) au moment de la lecture.
model DelegationGrant {
  id            String    @id @default(uuid())
  delegateId    String
  delegate      Employee  @relation("DelegationDelegate", fields: [delegateId], references: [id])
  grantedById   String
  grantedBy     Employee  @relation("DelegationGrantedBy", fields: [grantedById], references: [id])
  categories    String[] // sous-ensemble de ["hours","purchases","service","changes"]
  monetaryLimit Decimal?  @db.Decimal(10, 2)
  startDate     DateTime  @db.Date
  endDate       DateTime  @db.Date
  justification String
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([delegateId, startDate, endDate])
}

// ---------------------------------------------------------------------------
// Contacts / CRM
// ---------------------------------------------------------------------------

model Contact {
  id         String   @id @default(uuid())
  type       String   @default("Client")
  company    String?
  name       String
  role       String? // ex. "Contact client"
  email      String?
  phone      String?
  categories String[] // ex. ["Client", "Projet", "Roulement"]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clientRequests ClientRequest[]
  projects       Project[]
  rollings       Rolling[]
  serviceCalls   ServiceCall[]
  deliveries     Delivery[]

  @@index([email])
  @@index([name])
}

model SalesChannel {
  id        String  @id @default(uuid())
  name      String  @unique
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  clientRequests ClientRequest[]
}

// ---------------------------------------------------------------------------
// Demandes clients
// ---------------------------------------------------------------------------

model ClientRequest {
  id                   String        @id @default(uuid())
  displayId            String        @unique // format DC-AAAA-NNNN
  createdById          String
  contactId            String
  contact              Contact       @relation(fields: [contactId], references: [id])
  contactName          String
  contactRole          String?
  company              String?
  email                String?
  phone                String?
  address              String?
  summary              String
  requestType          String // project | rolling | service | information
  urgency              String?
  salesChannelId       String?
  salesChannel         SalesChannel? @relation(fields: [salesChannelId], references: [id])
  sourceDetail         String?
  status               String        @default("new")
  assignedEmployeeId   String?
  transmittedToOwnerAt DateTime? // visibilité seulement — jamais une porte de permission (voir roles.ts)
  budgetId             String?       @unique
  budget               Budget?       @relation(fields: [budgetId], references: [id])
  // Conversion directe en call de service (27 août 2026, demande explicite,
  // uniquement proposée quand requestType==="service") — même mécanique et
  // même relation gérée que budgetId/budget juste au-dessus : la colonne
  // miroir simple vit sur ServiceCall.clientRequestId (voir ce champ,
  // même raison documentée sur Budget.clientRequestId).
  serviceCallId        String?       @unique
  serviceCall          ServiceCall?  @relation(fields: [serviceCallId], references: [id])
  convertedType        String? // project | rolling
  convertedProjectId   String?
  convertedRollingId   String?
  lostReason           String?
  nextFollowUp         DateTime?
  // Corbeille — même mécanisme que Project.deletedAt (18 août 2026) :
  // masqué des listes actives, jamais une suppression physique. Bloqué si
  // budgetId est déjà lié (voir deleteClientRequest, service.ts).
  deletedAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  notes    ClientRequestNote[]
  projects Project[]
  rollings Rolling[]

  @@index([status])
}

model ClientRequestNote {
  id              String        @id @default(uuid())
  clientRequestId String
  clientRequest   ClientRequest @relation(fields: [clientRequestId], references: [id])
  authorId        String
  body            String
  createdAt       DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Budgétaire
// ---------------------------------------------------------------------------

/// Singleton (une seule ligne) — modèle courant, propagé automatiquement à tout nouveau budgétaire.
model BudgetModel {
  id               String               @id @default(uuid())
  backupHourlyRate Decimal              @default(112) @db.Decimal(10, 2)
  backupDefaultPct Decimal              @default(10) @db.Decimal(5, 2)
  updatedById      String?
  updatedAt        DateTime             @updatedAt
  sections         BudgetModelSection[]
}

model BudgetModelSection {
  id            String            @id @default(uuid())
  budgetModelId String
  budgetModel   BudgetModel       @relation(fields: [budgetModelId], references: [id])
  category      BudgetCategory
  kind          BudgetSectionKind
  sortOrder     Int               @default(0)
  rows          BudgetModelRow[]

  @@unique([budgetModelId, category])
}

model BudgetModelRow {
  id            String             @id @default(uuid())
  sectionId     String
  section       BudgetModelSection @relation(fields: [sectionId], references: [id])
  slug          String // identifiant stable, ex. "fabrication-plasma"
  label         String // renommable (Direction, Paramètres) — non rétroactif, voir spec
  hourlyRate    Decimal            @default(0) @db.Decimal(10, 2) // lignes de type "labor" seulement
  unitPrice     Decimal            @default(0) @db.Decimal(10, 2) // lignes de type "purchase" seulement
  // Modifiable Direction seulement (vrai, par défaut) vs Direction ET
  // Propriétaire (faux) — varie PAR LIGNE, pas seulement par catégorie
  // (ex. Installation — Frais divers mélange les deux). Vérifié dans le
  // prototype v19 (12 août 2026).
  directionOnly Boolean            @default(true)
  // Ligne calculée automatiquement à partir d'une AUTRE ligne de la même
  // section (ex. « Conception plus 10 % »), jamais saisie directement —
  // heures effectives = heures de autoFromRow × autoPct / 100.
  autoFromRowId String?
  autoFromRow   BudgetModelRow?    @relation("BudgetModelRowAuto", fields: [autoFromRowId], references: [id])
  autoRows      BudgetModelRow[]   @relation("BudgetModelRowAuto")
  autoPct       Decimal?           @db.Decimal(5, 2)
  active        Boolean            @default(true) // retrait = désactivation, jamais une suppression physique
  sortOrder     Int                @default(0)
  // Lien direct vers la tâche punchable correspondante (18 août 2026,
  // confirmé par l'utilisatrice) — voir PunchableTask.budgetModelRowId
  // ci-dessous pour le raisonnement complet. Nul pour les lignes de type
  // "purchase" (jamais punchables) et pour les lignes auto-calculées
  // (autoFromRowId non nul, ex. « Conception plus 10 % »).
  punchableTask PunchableTask?

  @@unique([sectionId, slug])
}

enum BudgetSectionKind {
  labor
  purchase
}

/// Vérifié directement dans le prototype v19 (12 août 2026) — 13 catégories
/// réelles réparties en 3 groupes visuels (voir CATEGORY_LABELS/BUDGET_GROUPS
/// côté application, jamais recalculé ici) : Main-d'œuvre (conception,
/// fabrication, panelProgramming, assemblyTest, installationLabor), Achats
/// prévus (stockFabrication, stockPanel, motorization, hardware,
/// consumables, subcontracting), Installation (installationLabor déjà listée,
/// installationStock, installationExpenses).
enum BudgetCategory {
  conception
  fabrication
  panelProgramming
  assemblyTest
  installationLabor
  stockFabrication
  stockPanel
  motorization
  hardware
  consumables
  subcontracting
  installationStock
  installationExpenses
}

model Budget {
  id                      String    @id @default(uuid())
  displayId               String    @unique // format BG-AAAA-NNNN
  // Nullable — confirmé : un budgétaire peut aussi être créé directement
  // (voir spec/plan). PAS @unique (retiré le 18 août 2026) : miroir simple
  // (pas de @relation dessus — voir service.ts), gardé volontairement
  // NON vidé quand un budgétaire est supprimé ou refusé, pour rester la
  // seule trace de son client d'origine — donc plusieurs budgétaires
  // (un ancien refusé/supprimé + un nouveau) peuvent légitimement pointer
  // vers la même demande au fil du temps. La relation vraiment gérée
  // (un SEUL budgétaire actif par demande) vit sur ClientRequest.budgetId,
  // @unique celui-là.
  clientRequestId         String?
  status                  String    @default("draft")
  // Back-up D'HEURES — réserve calculée automatiquement depuis les heures
  // admissibles (Fab+Prog+Assemblage), voir backup.ts. Gelé au premier calcul.
  backupHourlyRate        Decimal   @db.Decimal(10, 2)
  backupHoursPct          Decimal   @default(10) @db.Decimal(5, 2)
  backupHoursComplexity   Int       @default(0) // 0-10
  // Back-up PROJET — distinct du back-up d'heures ci-dessus (confirmé le 12
  // août 2026) : montant saisi à la main par Direction, pas dérivé des
  // heures. La complexité détermine seulement la marge appliquée à ce
  // montant (même mécanisme que sectionSummary/backupSummary).
  projectBackupAmount     Decimal   @default(0) @db.Decimal(10, 2)
  projectBackupComplexity Int       @default(0) // 0-10
  // Champs d'en-tête du budgétaire — vérifiés dans le prototype v19 (12 août 2026).
  poNumber                String?
  quantity                Int       @default(1)
  validUntil              DateTime?
  summary                 String? // résumé du budgétaire (portée, hypothèses, échéancier)
  riskSummary             String? // résumé des risques
  createdById             String
  createdAt               DateTime  @default(now())
  sentAt                  DateTime?
  contractWonAt           DateTime?
  // Corbeille — même mécanisme que Project.deletedAt/ClientRequest.deletedAt
  // (18 août 2026) : masqué de la liste active, jamais une suppression
  // physique. Bloqué si déjà converti en projet ou roulement (voir
  // deleteBudget, service.ts) — décroche la demande client liée le cas
  // échéant (budgetId remis à nul, statut remis à "in_progress").
  deletedAt               DateTime?

  clientRequest ClientRequest?
  sections      BudgetSection[]
  project       Project?
  // Conversion budgétaire → roulement : PAS ENCORE construite, à ne pas
  // oublier (18 août 2026, confirmé par l'utilisatrice) — le module
  // Roulement lui-même n'est pas encore déployé. listBudgets() exclut déjà
  // les budgétaires où cette relation serait posée, en prévision (même
  // filtre que pour "project" ci-dessus), mais rien ne la pose encore.
  rolling       Rolling?
  notes         BudgetNote[]

  @@index([status])
}

/// Notes datées pour le suivi client (25 août 2026) — même mécanisme que ClientRequestNote, jamais modifiées/supprimées après coup.
model BudgetNote {
  id        String   @id @default(uuid())
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id])
  authorId  String
  body      String
  createdAt DateTime @default(now())
}

model BudgetSection {
  id         String            @id @default(uuid())
  budgetId   String
  budget     Budget            @relation(fields: [budgetId], references: [id])
  category   BudgetCategory
  kind       BudgetSectionKind // gelé au moment de la création (copié du modèle)
  complexity Int               @default(0) // 0-10, PAR SECTION (confirmé le 11 et reconfirmé le 12 août 2026 — pas un seul niveau projet, pas par ligne)
  rows       BudgetRow[]

  @@unique([budgetId, category])
}

model BudgetRow {
  id            String        @id @default(uuid())
  sectionId     String
  section       BudgetSection @relation(fields: [sectionId], references: [id])
  modelRowId    String? // traçabilité seulement, absent pour une ligne ajoutée à la main — label/taux ci-dessous sont des copies gelées
  label         String
  hourlyRate    Decimal       @default(0) @db.Decimal(10, 2) // lignes "labor" seulement
  hours         Decimal       @default(0) @db.Decimal(10, 2) // lignes "labor" seulement (ou calculé, voir autoFromRowId)
  qty           Decimal       @default(0) @db.Decimal(10, 2) // lignes "purchase" seulement
  unitPrice     Decimal       @default(0) @db.Decimal(10, 2) // lignes "purchase" seulement
  directionOnly Boolean       @default(true) // Modifiable Direction seulement vs Direction ET Propriétaire — gelé depuis le modèle, voir BudgetModelRow
  autoFromRowId String? // ligne dont "hours" est dérivé automatiquement (× autoPct) — non modifiable directement si non nul
  autoFromRow   BudgetRow?    @relation("BudgetRowAuto", fields: [autoFromRowId], references: [id])
  autoRows      BudgetRow[]   @relation("BudgetRowAuto")
  autoPct       Decimal?      @db.Decimal(5, 2)
  risk          String? // risque, hypothèse ou note — vérifié dans le prototype v19 (12 août 2026)
  createdAt     DateTime      @default(now())
  // Ordre d'affichage figé — copié de BudgetModelRow.sortOrder à la création
  // (voir createBudget(), budgets/service.ts). Sans lui, la requête qui lit
  // les lignes n'a aucun ORDER BY : Postgres ne garantit alors aucun ordre
  // stable, et un UPDATE peut déplacer la ligne modifiée dans le scan
  // suivant — bug réel signalé par l'utilisatrice le 13 août 2026 (une
  // ligne « saute » en bas de la liste dès qu'on y saisit une valeur).
  sortOrder     Int           @default(0)
}

// ---------------------------------------------------------------------------
// Projets
// ---------------------------------------------------------------------------

model Project {
  id                          String         @id @default(uuid())
  projectNumber               String         @unique
  name                        String
  contactId                   String
  contact                     Contact        @relation(fields: [contactId], references: [id])
  clientRequestId             String?        @unique
  clientRequest               ClientRequest? @relation(fields: [clientRequestId], references: [id])
  budgetId                    String?        @unique // nullable — création directe possible, avec ou sans budgétaire (confirmé)
  budget                      Budget?        @relation(fields: [budgetId], references: [id])
  status                      String         @default("active")
  priority                    Int            @default(0)
  sold                        Decimal        @default(0) @db.Decimal(12, 2)
  plannedPurchases            Decimal        @default(0) @db.Decimal(12, 2)
  actualPurchases             Decimal        @default(0) @db.Decimal(12, 2)
  laborHours                  Decimal        @default(0) @db.Decimal(10, 2)
  laborCost                   Decimal        @default(0) @db.Decimal(12, 2)
  plannedHours                Decimal        @default(0) @db.Decimal(10, 2)
  actualHours                 Decimal        @default(0) @db.Decimal(10, 2)
  backupHours                 Decimal        @default(0) @db.Decimal(10, 2)
  backupHoursCost             Decimal        @default(0) @db.Decimal(12, 2)
  backupHourlyRate            Decimal?       @db.Decimal(10, 2) // taux gelé du budgétaire d'origine — utilisé par les avenants
  // Réserve monétaire liée au projet, distincte du back-up d'heures —
  // jamais alimentée par un achat ou un punch réel, mais entre dans le
  // calcul de la marge réelle (confirmé par capture d'écran de la vue
  // projet v19, 12 août 2026). Gelée depuis Budget.projectBackupAmount au
  // moment de la conversion.
  projectBackupAmount         Decimal        @default(0) @db.Decimal(12, 2)
  // Total heures + achats + frais divers des 3 catégories du groupe
  // "installation" (installationLabor/installationStock/installationExpenses),
  // AVANT marge — confirmé le 17 août 2026 : corrige la tuile "Livraison
  // planifiée" de la référence v19 (erreur de libellé — ce n'est pas une
  // catégorie du budgétaire). Gelé à la conversion, même esprit que
  // plannedHours/plannedPurchases ci-dessus.
  installationPlannedHours    Decimal        @default(0) @db.Decimal(10, 2)
  installationPlannedCost     Decimal        @default(0) @db.Decimal(12, 2)
  // Marge globale du budgétaire d'origine (prix vendu total vs coût total),
  // gelée une seule fois au moment de la conversion — ne change plus
  // jamais ensuite, même si un avenant fait varier la marge réelle
  // ci-dessus. Absente pour un projet créé directement, sans budgétaire.
  // Nouvelle case demandée par l'utilisatrice, absente de la v19 elle-même.
  targetMarginPct             Decimal?       @db.Decimal(5, 2)
  billingSplitOverride        Json?
  deadline                    DateTime?
  desiredStart                DateTime?
  productionCompleted         Boolean        @default(false)
  fulfillmentMode             String?
  fulfillmentStatus           String?
  fulfillmentDriverId         String?
  fulfillmentAddress          String?
  fulfillmentScheduled        DateTime?
  // Champs de fulfillment.ts (FulfillmentEntity) restés absents jusqu'ici —
  // Phase 2C (17 août 2026). billingReady ne se met à true que pour les
  // modes tiers/ramassage confirmés (confirmFulfillment) — jamais pour
  // warehouse, dont la confirmation vient du Bon de livraison (Delivery)
  // lui-même, pas de ce champ.
  billingReady                Boolean        @default(false)
  fulfillmentConfirmationNote String?
  // Garantie (Projet 2D, 17 août 2026) — deux données indépendantes,
  // confirmées par Q&R avec l'utilisatrice. warrantyExpected : coché dès la
  // création si on sait déjà que ce projet ira en garantie, mais pas
  // encore quand — purement informatif, n'active rien seul. warrantyEndsAt :
  // le vrai interrupteur (nul = pas en garantie, rempli = en garantie
  // jusqu'à cette date). Un projet peut être fermé (closedAt) ET en
  // garantie active en même temps — pas une contradiction, ça ne dépend
  // pas du statut du projet (confirmé). Onglet "Garantie" dérivé de
  // warrantyEndsAt à la lecture (voir warranty.ts), jamais un nouveau
  // statut stocké — expire tout seul, sans job ni geste manuel.
  warrantyExpected            Boolean        @default(false)
  warrantyEndsAt              DateTime?
  closedAt                    DateTime? // geste manuel séparé — jamais un effet de bord du mode de sortie
  // Menu Options du projet (Projet 2F, 17 août 2026) — deux gestes séparés
  // de closedAt, confirmés par capture d'écran (section "Actions
  // sensibles" du menu). archivedAt : reste pleinement accessible (lien
  // direct, getProjectDetail), seulement sorti des listes actives — même
  // esprit que le Budgétaire archivé. deletedAt : mécanisme de corbeille
  // seulement (masqué des listes) — l'écran de restauration 90 jours lui-
  // même attend le module Paramètres complet (confirmé, pas construit ici).
  archivedAt                  DateTime?
  deletedAt                   DateTime?
  // Post-mortem — « Analyse finale » (Projet 2E, 17 août 2026) — seule
  // vraie nouvelle donnée du Post-mortem, tout le reste de l'écran
  // réutilise des chiffres déjà calculés ailleurs (comparatif, achats,
  // réserves, marge). Direction seulement (canManagePostMortem),
  // modifiable n'importe quand — pas de préalable de fermeture, même
  // esprit que la Garantie. Le comparatif détaillé par sous-tâche reste
  // hors de cette étape — confirmé complexe, spécification à venir de
  // l'utilisatrice avant de construire le lien punch → tâche.
  postMortemDepassements      String?
  postMortemAmeliorations     String?
  postMortemRecommandation    String?
  createdById                 String
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  team             ProjectTeamMember[]
  tasks            ProjectTask[]
  invoiceEntries   InvoicePlanEntry[]
  purchases        ProjectPurchaseEntry[]
  purchaseRequests PurchaseRequest[]
  timeEntries      TimeEntry[]
  subassemblies    Subassembly[]
  amendments       Amendment[]
  deliveries       Delivery[]
  warrantyHistory  WarrantyHistoryEntry[]
  serviceCalls     ServiceCall[]
  checklists       ProductionChecklist[]

  @@index([status])
}

/**
 * Historique des changements de date de fin de garantie (Projet 2D, 17 août
 * 2026) — un projet peut passer de 1 an à 2 ans, etc. changedById reste un
 * scalaire simple (pas de relation Prisma), même patron que
 * ProjectPurchaseEntry.enteredById/approvedById — nom résolu via une
 * recherche groupée séparée, jamais une nouvelle relation. invoiceReference
 * : référence libre (texte) vers une facture existante, quand applicable —
 * rare en pratique (confirmé), jamais une facture générée automatiquement.
 */
model WarrantyHistoryEntry {
  id               String    @id @default(uuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id])
  previousEndsAt   DateTime? // nul pour la toute première activation
  newEndsAt        DateTime
  reason           String?
  invoiceReference String?
  changedById      String
  changedAt        DateTime  @default(now())

  @@index([projectId])
}

model ProjectTeamMember {
  id         String  @id @default(uuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id])
  employeeId String

  @@unique([projectId, employeeId])
}

model ProjectTask {
  id                 String       @id @default(uuid())
  projectId          String
  project            Project      @relation(fields: [projectId], references: [id])
  subassemblyId      String?
  subassembly        Subassembly? @relation(fields: [subassemblyId], references: [id])
  amendmentId        String?
  amendment          Amendment?   @relation(fields: [amendmentId], references: [id])
  name               String
  category           String
  subcategory        String?
  skill              String?
  // Affectation manuelle (Direction seulement, voir canEditGanttSchedule) —
  // nullable : tant qu'aucun employé n'est assigné, la tâche reste non
  // planifiable (pas d'auto-répartition dans cette phase, voir gantt/service.ts).
  assignedEmployeeId String?
  assignedEmployee   Employee?    @relation(fields: [assignedEmployeeId], references: [id])
  plannedHours       Decimal      @default(0) @db.Decimal(10, 2)
  plannedCost        Decimal      @default(0) @db.Decimal(12, 2)
  actualHours        Decimal      @default(0) @db.Decimal(10, 2)
  actualCost         Decimal      @default(0) @db.Decimal(12, 2)
  purchases          Decimal      @default(0) @db.Decimal(12, 2)
  maxPeople          Int?
  minPeople          Int?
  desiredStart       DateTime?
  ganttCompleted     Boolean      @default(false) // geste explicite — jamais un effet de bord des heures consommées

  dependsOn    ProjectTaskDependency[] @relation("TaskDependsOn")
  dependedOnBy ProjectTaskDependency[] @relation("TaskDependedOnBy")

  @@index([projectId])
  @@index([assignedEmployeeId])
}

model ProjectTaskDependency {
  id            String      @id @default(uuid())
  taskId        String
  task          ProjectTask @relation("TaskDependsOn", fields: [taskId], references: [id])
  dependsOnId   String
  dependsOnTask ProjectTask @relation("TaskDependedOnBy", fields: [dependsOnId], references: [id])

  @@unique([taskId, dependsOnId])
}

// ---------------------------------------------------------------------------
// Facturation (suivi manuel — jamais de génération, voir billing.ts)
// ---------------------------------------------------------------------------

model InvoicePlanEntry {
  id            String       @id @default(uuid())
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id])
  rollingId     String?
  rolling       Rolling?     @relation(fields: [rollingId], references: [id])
  serviceCallId String?
  serviceCall   ServiceCall? @relation(fields: [serviceCallId], references: [id])
  label         String
  pct           Decimal      @db.Decimal(5, 2)
  amount        Decimal      @db.Decimal(12, 2)
  status        String       @default("pending") // pending | sent | paid | on_hold (calculé à la lecture par billing.ts)
  invoiceNumber String? // saisi manuellement, reflète Sage
  dueDate       DateTime?
  paidAmount    Decimal      @default(0) @db.Decimal(12, 2)
  paidAt        DateTime?
  isExtra       Boolean      @default(false) // 5e jalon (extra installation / avenant) plutôt qu'un des 4 standards
  requestedById String?
  requestedAt   DateTime?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  // Ordre d'affichage explicite (23 août 2026) — les jalons standards d'un
  // même projet/roulement sont créés en un seul createMany, donc partagent
  // souvent le même createdAt à la microseconde près; trier sur createdAt
  // seul n'a alors aucun départage déterministe et une ligne peut sembler
  // sauter de position au prochain chargement (rapporté par l'utilisatrice :
  // "l'ordre doit rester fixé"). Peuplé à la création (index dans le plan
  // pour les 4 jalons standards, max+1 pour un extra ajouté après coup).
  sortOrder     Int          @default(0)

  @@index([status])
}

// ---------------------------------------------------------------------------
// Achats — deux mécanismes distincts (confirmé, pas une contradiction)
// ---------------------------------------------------------------------------

model ProjectPurchaseEntry {
  id           String    @id @default(uuid())
  // projectId/rollingId : exactement un des deux non nul, jamais les deux
  // (validé côté service, pas en contrainte DB — même convention que
  // InvoicePlanEntry ci-dessus, qui partage déjà projectId?/rollingId? côte
  // à côte). Nom du modèle inchangé malgré l'ajout de rollingId (28 août
  // 2026, achats réels pour un roulement) — même choix qu'InvoicePlanEntry,
  // jamais renommé non plus pour la même raison.
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  rollingId    String?
  rolling      Rolling?  @relation(fields: [rollingId], references: [id])
  date         DateTime  @db.Date
  category     String
  supplier     String?
  description  String
  amount       Decimal   @db.Decimal(12, 2)
  enteredById  String
  status       String    @default("pending") // pending | approved — jamais de double autorisation du Propriétaire
  approvedById String?
  approvedAt   DateTime?
  note         String?
  createdAt    DateTime  @default(now())
}

model PurchaseCategory {
  id              String  @id @default(uuid())
  name            String  @unique
  thresholdAmount Decimal @db.Decimal(12, 2)
  active          Boolean @default(true) // "supprimer" dans Paramètres = désactiver, jamais une suppression réelle (mêmes demandes déjà faites la référencent)
  sortOrder       Int     @default(0)

  purchaseRequests PurchaseRequest[]
}

model PurchaseRequest {
  id                          String            @id @default(uuid())
  displayId                   String            @unique // format DA-AAAA-NNNN
  requesterId                 String // n'importe quel persona — mécanisme ouvert à tous, y compris Employé/Magasinier
  requester                   Employee          @relation("PurchaseRequestRequester", fields: [requesterId], references: [id])
  projectType                 String // project | service | internal
  projectId                   String?
  project                     Project?          @relation(fields: [projectId], references: [id])
  serviceCallId               String?
  // Nullable depuis le 12 août 2026 : la liste rapide d'achats de projet
  // crée des lignes SANS catégorie, par choix — c'est justement l'absence
  // de catégorie à seuil qui fait qu'aucune double autorisation du
  // Propriétaire ne s'applique jamais à ces lignes-là, sans code spécial
  // (canApprovePurchaseRequest ne trouve simplement aucun seuil à dépasser).
  // Liste rapide ouverte à TOUS les rôles depuis le 13 août 2026 (confirmé
  // explicitement par l'utilisatrice après qu'on lui ait signalé que ça
  // permet à n'importe qui de contourner le seuil en n'entrant aucune
  // catégorie — voulu). Voir canSubmitPurchaseRequest dans roles.ts.
  categoryId                  String?
  category                    PurchaseCategory? @relation(fields: [categoryId], references: [id])
  // Gelé au moment de la soumission, à partir de PurchaseCategory.thresholdAmount
  // — confirmé le 12 août 2026 : un changement de seuil par Direction ne
  // s'applique jamais rétroactivement à une demande déjà en attente, même
  // esprit que les autres taux gelés (ex. Budget.backupHourlyRate). Nul si
  // categoryId est nul (liste rapide — jamais de seuil de toute façon).
  thresholdAmountAtSubmission Decimal?          @db.Decimal(12, 2)
  supplier                    String? // texte libre, plusieurs fournisseurs séparés par des virgules acceptés
  description                 String
  // Nullable : la liste rapide permet un prix facultatif à la soumission —
  // Direction le complète/l'ajuste avant d'approuver (même esprit que le
  // prix des pièces d'appel de service, 0$ jusqu'à tarification).
  amount                      Decimal?          @db.Decimal(12, 2)
  // Fourchette de prix optionnelle fournie à la soumission par la liste
  // rapide (ex. Marc ne connaît pas encore de prix ferme) — jamais utilisée
  // pour les demandes d'achat régulières, seulement affichée en attendant
  // qu'`amount` soit confirmé.
  estimatedAmountMin          Decimal?          @db.Decimal(12, 2)
  estimatedAmountMax          Decimal?          @db.Decimal(12, 2)
  status                      String            @default("owner_pending") // owner_pending | boss_pending | authorized | rejected
  ownerApprovedById           String?
  ownerApprovedAt             DateTime?
  bossApprovedById            String?
  bossApprovedAt              DateTime?
  rejectedReason              String?
  requestedAt                 DateTime          @default(now())
  note                        String?
  // Édition par le demandeur — confirmé le 13 août 2026 : chacun peut
  // modifier description/fournisseur/montant estimé de sa PROPRE demande
  // tant qu'elle reste owner_pending/boss_pending, jamais après (voir
  // updatePurchaseRequest, purchases/service.ts). Sert de signal pour
  // Direction dans son centre d'action (PurchaseRequestList) — volontairement
  // pas de système de notification séparé, juste ce champ mis en évidence
  // tant que le statut reste en attente.
  editedAt                    DateTime?
  // Suivi post-autorisation — confirmé le 13 août 2026, DISTINCT du statut
  // d'approbation ci-dessus. Rempli à "waiting" automatiquement au moment
  // de l'autorisation (voir approvePurchaseRequest), puis Direction le fait
  // progresser manuellement : waiting -> ordered -> received (en attente /
  // commandé / reçu). Reste nul pour une demande encore en attente ou
  // rejetée.
  fulfillmentStatus           String?
  // Étape explicite ajoutée le 13 août 2026 : un achat autorisé ne compte
  // dans les totaux/le détail du projet qu'une fois appliqué — jamais
  // automatique à l'autorisation. Exige fulfillmentStatus === "received"
  // avant de pouvoir être posé (voir applyPurchaseRequestToProject).
  appliedToProjectAt          DateTime?
  // Date visée de réception (25 août 2026, demande explicite pour faciliter
  // le suivi) — purement informatif, jamais utilisé par une règle métier
  // (pas de restriction de statut pour la modifier, contrairement à amount).
  expectedReceiptDate         DateTime?         @db.Date

  @@index([status])
  @@index([requesterId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Punchs / temps
// ---------------------------------------------------------------------------

model PunchableTask {
  id                  String          @id @default(uuid())
  category            String
  label               String
  active              Boolean         @default(true)
  sortOrder           Int             @default(0)
  // Lien direct vers la ligne du modèle de budgétaire "labor" correspondante
  // — même tâche, utilisée à la fois pour planifier (budgétaire) et pour
  // puncher. Confirmé par l'utilisatrice le 18 août 2026 : elle veut un
  // vrai lien, pas un simple appariement par libellé — ajouter/renommer/
  // retirer une tâche doit se refléter des deux côtés. Pour l'instant, ce
  // lien est maintenu par seedBudgetModel() (scripts/seed.ts) : les deux
  // catalogues sont dérivés de la MÊME entrée CATEGORY_ROWS à chaque
  // re-seed, donc toujours en accord par construction. Nul pour une tâche
  // punchable SANS ligne budgétaire (ex. futures tâches
  // "Interne — Amélioration GSC", spec 8 août 2026, hors budget de projet).
  // L'interface Paramètres pour ajouter/modifier une tâche en dehors du
  // seed n'existe pas encore — choix de portée de cette passe (18 août
  // 2026, pas confirmé mot pour mot avec l'utilisatrice) : ni PunchableTask
  // ni BudgetModelRow n'ont de consommateur réel aujourd'hui (punch
  // d'heures = squelette, modèle de budgétaire = seed seulement) — cette
  // passe pose donc le lien réel/vérifié d'abord; la gestion Direction-
  // facing (ajouter une tâche depuis l'interface) est la suite logique.
  budgetModelRowId    String?         @unique
  budgetModelRow      BudgetModelRow? @relation(fields: [budgetModelRowId], references: [id])
  // Tarif fixe ($/h) qui remplace le taux de la classe facturable choisie au
  // punch (TimeEntry.techLevelId/rateType) pour CETTE tâche précise — utile
  // seulement pour une tâche de catégorie "service" (ex. Recherche à un tarif
  // fixe peu importe qui la fait). Nul = comportement inchangé, le taux de la
  // classe s'applique (confirmé par l'utilisatrice le 20 août 2026).
  specificServiceRate Decimal?        @db.Decimal(10, 2)

  timeEntries TimeEntry[]
}

model TimeEntry {
  id             String         @id @default(uuid())
  date           DateTime       @db.Date
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id])
  projectType    String // project | service | internal | rolling
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id])
  serviceCallId  String?
  serviceCall    ServiceCall?   @relation(fields: [serviceCallId], references: [id])
  // Punch sur un roulement (28 août 2026, demande de l'utilisatrice) — même
  // mécanique que projectId/serviceCallId ci-dessus, jamais un dossier
  // générique partagé : chaque type de dossier garde son propre FK nullable.
  rollingId      String?
  rolling        Rolling?       @relation(fields: [rollingId], references: [id])
  category       String
  taskId         String?
  task           PunchableTask? @relation(fields: [taskId], references: [id])
  startAt        DateTime
  endAt          DateTime?
  exactMinutes   Int?
  roundedMinutes Int?
  note           String?
  status         String         @default("submitted") // submitted | approved
  costRate       Decimal        @db.Decimal(10, 2) // gelé au moment du punch
  // Classe + type de temps choisis au punch — seulement pour projectType
  // === "service" (call de service), confirmé par l'utilisatrice le 18 août
  // 2026 : le choix se fait à chaque punch, jamais fixé une fois pour
  // toutes sur l'employé (voir Employee.techLevels — plusieurs classes
  // possibles par personne, celle qui s'applique dépend de la job). Nul
  // pour un punch projet/interne.
  techLevelId    String?
  techLevel      TechLevel?     @relation(fields: [techLevelId], references: [id])
  rateType       String? // regular | overtime | extra — nul si non applicable
  blockageNote   String?
  createdAt      DateTime       @default(now())
  // Corbeille — même mécanisme que Project/Budget/ClientRequest/ServiceCall.deletedAt
  // (20 août 2026) : Direction seulement (canDeleteTimeEntry), pour corriger une
  // erreur de punch signalée à l'approbation.
  deletedAt      DateTime?

  @@index([employeeId, date])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Appels de service
// ---------------------------------------------------------------------------

model ServiceCall {
  id                           String     @id @default(uuid())
  displayId                    String     @unique // format CS-AAAA-NNNN
  contactId                    String
  contact                      Contact    @relation(fields: [contactId], references: [id])
  // Colonne miroir simple (pas de @relation dessus) quand ce call vient
  // d'une conversion directe depuis une demande client — la relation Prisma
  // gérée vit sur ClientRequest.serviceCallId, même patron que
  // Budget.clientRequestId/ClientRequest.budgetId (voir budgets/service.ts,
  // commentaire d'en-tête) : gardée synchronisée manuellement en service.ts.
  clientRequestId              String?
  // Call "lié" à un projet (27 août 2026, demande explicite — visites de
  // suivi/garantie) — relation gérée normale, PAS le patron miroir de
  // clientRequestId ci-dessus : plusieurs calls peuvent légitimement viser
  // le même projet (plusieurs visites), donc aucune contrainte unique.
  // Toujours non-facturable (voir sentToAdminAt/sendServiceCallToAdmin,
  // service.ts) — être lié suffit à lui seul, aucun champ séparé pour ça.
  projectId                    String?
  project                      Project?   @relation(fields: [projectId], references: [id])
  // Call "lié" à un roulement (28 août 2026) — même mécanisme exact que
  // projectId ci-dessus (relation gérée normale, plusieurs calls possibles
  // par roulement, toujours non-facturable une fois lié).
  rollingId                    String?
  rolling                      Rolling?   @relation(fields: [rollingId], references: [id])
  // Titre court affiché partout (liste, sous-titre du détail, rapports,
  // facturation, dossiers liés du contact) — distinct de request : avant ce
  // champ (27 août 2026), la liste affichait le texte brut de la demande
  // (souvent long, en majuscules, copié d'un client) comme s'il s'agissait
  // d'un titre. Nullable pour les calls déjà existants au moment de la
  // migration (jamais de valeur devinée pour eux) — voir serviceCallDisplayTitle
  // (serviceCalls/service.ts), qui retombe sur request tant que title est nul.
  title                        String?
  request                      String
  // Snapshot au moment de la demande, comme ClientRequest.address — Contact
  // n'a volontairement pas de champ adresse (carnet simple, voir spec).
  address                      String?
  // Plusieurs techniciens possibles sur un même call (confirmé par
  // l'utilisatrice le 19 août 2026 — "ils doivent parfois y aller à deux
  // techniciens") — remplace l'ancien assignedEmployeeId singulier.
  assignedEmployees            Employee[]
  techLevelId                  String?
  billRate                     Decimal?   @db.Decimal(10, 2) // gelé du TechLevel au moment de l'assignation
  scheduledAt                  DateTime?
  status                       String     @default("scheduled")
  startAt                      DateTime?
  endAt                        DateTime?
  kmTraveled                   Decimal?   @db.Decimal(10, 2)
  mealsClaimed                 String[]   @default([])
  summary                      String?
  signatureCaptured            Boolean    @default(false)
  signatureImageUrl            String?
  // Déclaration + nom du signataire obligatoires à la capture (20 août 2026,
  // sur demande de l'utilisatrice) — voir SignatureModal.tsx côté interface.
  signatureSignerName          String?
  ownerApprovedById            String?
  ownerApprovedAt              DateTime?
  partPricingMarginPctOverride Decimal?   @db.Decimal(5, 2)
  sentToAdminAt                DateTime?
  createdAt                    DateTime   @default(now())
  // Corbeille — même mécanisme que Project.deletedAt/ClientRequest.deletedAt/
  // Budget.deletedAt (19 août 2026) : Direction seulement (canDeleteServiceCall).
  deletedAt                    DateTime?

  parts          ServiceCallPart[]
  photos         ServiceCallPhoto[]
  invoiceEntries InvoicePlanEntry[]
  timeEntries    TimeEntry[]
  // Opposé requis de ClientRequest.serviceCall (relation gérée côté
  // ClientRequest, voir serviceCallId juste au-dessus) — jamais lu
  // directement ici, même patron que Budget.clientRequest.
  clientRequest  ClientRequest?

  @@index([status])
}

model ServiceCallPart {
  id                String      @id @default(uuid())
  serviceCallId     String
  serviceCall       ServiceCall @relation(fields: [serviceCallId], references: [id])
  name              String
  qty               Decimal     @db.Decimal(10, 2)
  unit              String?
  costPerUnit       Decimal?    @db.Decimal(10, 2) // 0$ jusqu'à ce que Direction tarife (voir spec)
  marginPctOverride Decimal?    @db.Decimal(5, 2)
  salePricePerUnit  Decimal?    @db.Decimal(10, 2)
  pricedById        String?
  pricedAt          DateTime?
}

model ServiceCallPhoto {
  id            String      @id @default(uuid())
  serviceCallId String
  serviceCall   ServiceCall @relation(fields: [serviceCallId], references: [id])
  storagePath   String
  uploadedById  String
  uploadedAt    DateTime    @default(now())
  caption       String?
}

