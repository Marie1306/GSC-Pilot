/// Singleton (une seule ligne).
model Settings {
  id                           String   @id @default(uuid())
  mileageRate                  Decimal  @default(0) @db.Decimal(10, 4)
  breakfastRate                Decimal  @default(0) @db.Decimal(10, 2)
  lunchRate                    Decimal  @default(0) @db.Decimal(10, 2)
  dinnerRate                   Decimal  @default(0) @db.Decimal(10, 2)
  // Stocké mais jamais automatiquement additionné nulle part (aucun
  // indicateur "call urgent" n'existe sur ServiceCall) — seule la valeur du
  // taux est gérée ici pour l'instant, confirmé le 20 août 2026 : appliquer
  // ce frais reste une décision manuelle de Direction, pas une règle
  // automatique à deviner.
  urgencyFee                   Decimal  @default(0) @db.Decimal(10, 2)
  defaultBillingSplit          Json // voir billing.ts DEFAULT_BILLING_SPLIT — lu par convertBudgetToProject/updateProjectPlanning (projects/service.ts)
  // Numéro de projet : nombre brut, jamais de préfixe ni de zéros devant
  // (confirmé le 17 août 2026 — contrairement à BG-AAAA-NNNN, DA-AAAA-NNNNN,
  // etc.). Modifiable à la conversion pour reprendre les numéros hérités de
  // l'ancien système (ex. 2267) — voir getNextProjectNumber/
  // convertBudgetToProject, projects/service.ts : toujours mis à jour au
  // maximum utilisé, jamais simplement incrémenté à l'aveugle.
  nextProjectNumber            Int      @default(1)
  nextPurchaseRequestNumber    Int      @default(1) // format DA-AAAA-NNNNN (5 chiffres, confirmé le 14 août 2026)
  // Année d'affaires (heure de l'Est/Québec, pas le fuseau du serveur) à
  // laquelle nextPurchaseRequestNumber ci-dessus s'applique — confirmé le
  // 14 août 2026 : remise à zéro automatique de la séquence chaque nouvelle
  // année, à la frontière réelle du 31 décembre 23h59 heure du Québec, pas
  // minuit UTC. Voir resolveNextPurchaseRequestNumber, purchases/service.ts.
  purchaseRequestNumberYear    Int      @default(2026)
  nextClientRequestNumber      Int      @default(1) // format DC-AAAA-NNNN
  nextBudgetNumber             Int      @default(1) // format BG-AAAA-NNNN
  nextDeliveryNumber           Int      @default(1) // format BL-AAAA-NNNN — même patron que nextBudgetNumber (année civile, pas d'année d'affaires)
  nextServiceCallNumber        Int      @default(1) // format CS-AAAA-NNNN — même patron que nextBudgetNumber/nextDeliveryNumber (année civile)
  nextRollingNumber            Int      @default(1) // format RL-AAAA-NNNN — même patron que nextBudgetNumber/nextDeliveryNumber/nextServiceCallNumber (année civile, confirmé le 28 août 2026)
  nextAmendmentNumber          Int      @default(1) // format AV-NNN — pas d'année (Amendment.displayId, voir amendments/service.ts)
  servicePartsDefaultMarginPct Decimal  @default(20) @db.Decimal(5, 2)
  punchRoundingMinutes         Int      @default(15)
  // Seuils du voyant de marge réelle (statut financier) — confirmé le 17
  // août 2026 : s'appliquent à projets, roulements et calls (recalculé à la
  // lecture à chaque punch/achat, jamais un champ figé sur l'entité).
  // marge >= marginConformeThreshold → Conforme; entre les deux → À risque;
  // < marginAtRiskThreshold → Critique. Modifiable par Direction seulement.
  marginConformeThreshold      Decimal  @default(30) @db.Decimal(5, 2)
  marginAtRiskThreshold        Decimal  @default(25) @db.Decimal(5, 2)
  updatedAt                    DateTime @updatedAt
}

model PdfTemplate {
  id          String   @id @default(uuid())
  name        String
  type        String
  storagePath String?
  builtIn     Boolean  @default(false)
  isDefault   Boolean  @default(false)
  importedAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Rapport d'erreurs (28 août 2026, nouveau module demandé par l'utilisatrice)
// Accessible Propriétaire et Direction seulement (canAccessErrorReports,
// roles.ts). L'employé "visé" doit être Employé ou Magasinier
// (canBeErrorReportSubject) — confirmé, ce sont les rôles de production.
// hourlyRateSnapshot GELÉ au moment de la création (même patron que
// TimeEntry.costRate) : la valeur des heures perdues reste exacte même si
// le taux de l'employé change ensuite. hoursValue n'existe PAS en colonne —
// toujours calculé à la lecture (hoursLost × hourlyRateSnapshot), même
// principe que Rolling.actualHours/actualPurchases.
//
// createdAt sert AUSSI de date de l'incident — verrouillée à la création,
// jamais modifiable (« date automatique », confirmé le 28 août 2026) : pas
// de colonne "date" séparée, elle serait toujours identique et risquerait
// de dériver pour rien.
//
// Photos en base64 (imageDataUrl) directement en base, PAS storagePath —
// confirmé en vérifiant le code : ServiceCallPhoto.storagePath existe au
// schéma depuis la fondation du projet mais n'a jamais eu de vrai chemin
// d'écriture (aucune intégration Supabase Storage nulle part dans ce
// projet). Le seul mécanisme d'image réellement construit et qui fonctionne
// est ServiceCall.signatureImageUrl (data URL base64 stockée telle quelle) —
// c'est celui-là qui est reproduit ici, pas le stub inutilisé.
//
// Pas d'édition après création (spec de l'utilisatrice ne la demande pas) —
// seulement créer et envoyer à la corbeille (deletedAt, Direction
// seulement, même palier que partout ailleurs) : un rapport d'erreur est un
// constat factuel, pas un document à corriger après coup.
// ---------------------------------------------------------------------------

model ErrorReport {
  id                 String             @id @default(uuid())
  employeeId         String
  employee           Employee           @relation("ErrorReportSubject", fields: [employeeId], references: [id])
  materialValue      Decimal            @default(0) @db.Decimal(12, 2)
  hoursLost          Decimal            @default(0) @db.Decimal(10, 2)
  hourlyRateSnapshot Decimal            @db.Decimal(10, 2)
  note               String?
  createdById        String
  createdBy          Employee           @relation("ErrorReportCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime           @default(now())
  deletedAt          DateTime?
  photos             ErrorReportPhoto[]

  @@index([employeeId])
}

model ErrorReportPhoto {
  id            String      @id @default(uuid())
  errorReportId String
  errorReport   ErrorReport @relation(fields: [errorReportId], references: [id])
  imageDataUrl  String
  uploadedAt    DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Note interne (29 août 2026, nouveau module demandé par l'utilisatrice) —
// message court d'un employé à un autre, OU à tout un rôle à la fois (chaque
// personne de ce rôle reçoit alors sa PROPRE copie, archivée individuellement
// — jamais une note "partagée" que n'importe qui du rôle pourrait acquitter à
// la place des autres). recipientId est toujours un employé précis, même
// pour un envoi "par rôle" : la résolution du rôle en liste d'employés se
// fait à L'ENVOI (teamNotes/service.ts), jamais stockée comme telle — un rôle
// qui change de composition plus tard n'affecte jamais les notes déjà
// envoyées. Accessible à tous les rôles — aucune permission dédiée dans
// roles.ts, seulement requireAuth (comme /api/me).
//
// readAt fait double emploi (confirmé par l'utilisatrice) : NULL = active
// (Centre d'actions), non NULL = archivée (bouton "Reçu", un crochet) — sert
// aussi de date d'archivage pour l'historique des 5 dernières notes.
// ---------------------------------------------------------------------------

model TeamNote {
  id          String    @id @default(uuid())
  senderId    String
  sender      Employee  @relation("TeamNoteSender", fields: [senderId], references: [id])
  recipientId String
  recipient   Employee  @relation("TeamNoteRecipient", fields: [recipientId], references: [id])
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([recipientId, readAt])
}
