# Copier vers .env et remplir avec les vraies valeurs du projet Supabase
# dédié à GSC Pilot (jamais celui d'une autre application — voir CLAUDE.md).
# Ce fichier .env.example est sûr à committer (aucune vraie valeur) ; .env
# lui-même est ignoré par git (voir .gitignore) — ne jamais l'y ajouter.

NODE_ENV=development
PORT=3000

# Supabase → Project Settings → Database → Connection string
# DATABASE_URL : connexion groupée (pooler / pgbouncer, port 6543) — utilisée par l'app en exécution.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xxxxx.pooler.supabase.com:6543/postgres"
# DIRECT_URL : connexion directe (port 5432) — utilisée seulement par les migrations (prisma.config.ts).
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xxxxx.pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API
SUPABASE_URL="https://xxxxx.supabase.co"
# Clé "service_role" — secrète, jamais envoyée au navigateur, jamais dans apps/web.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Origine(s) autorisées pour CORS, séparées par des virgules.
CORS_ORIGIN="http://localhost:5173"
